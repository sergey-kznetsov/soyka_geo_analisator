{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soika.invalid/schemas/connectors/html-source-profile-v1.schema.json",
  "title": "SOIKA HTML source profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "display_name", "kind", "base_url", "region", "municipalities",
    "discovery_mode", "discovery_urls", "selectors", "robots_url",
    "render_javascript", "enabled"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^(local-media|municipal)\\.[a-z0-9.-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["local_media", "municipal"]},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "region": {"type": "string", "minLength": 1},
    "municipalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "discovery_mode": {"enum": ["rss", "atom", "sitemap", "section", "index_page"]},
    "discovery_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "published_at"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "minLength": 1},
        "comment_item": {"type": "string", "minLength": 1},
        "comment_text": {"type": "string", "minLength": 1},
        "comment_id": {"type": "string", "minLength": 1},
        "comment_author": {"type": "string", "minLength": 1},
        "comment_published_at": {"type": "string", "minLength": 1},
        "comment_parent_id": {"type": "string", "minLength": 1}
      }
    },
    "robots_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "render_javascript": {"type": "boolean"},
    "rendering_justification": {"type": ["string", "null"]},
    "enabled": {"const": false}
  }
}
