{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soika-uds.dev/1.0.0/job-status.schema.json",
  "title": "SOIKA UDS Development job status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "analysis_id",
    "status",
    "updated_at",
    "progress_percent",
    "stage",
    "attempt",
    "warnings",
    "errors"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "message_type": {
      "const": "analysis.status"
    },
    "analysis_id": {
      "$ref": "common.schema.json#/$defs/analysisId"
    },
    "status": {
      "enum": [
        "queued",
        "preparing",
        "collecting",
        "preprocessing",
        "classifying",
        "geocoding",
        "filtering",
        "detecting_events",
        "calculating",
        "completed",
        "completed_with_warnings",
        "failed",
        "cancelled"
      ]
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/awareDateTime"
    },
    "progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "processed_items": {
      "type": "integer",
      "minimum": 0
    },
    "total_items": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/issue"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/issue"
      }
    }
  }
}
